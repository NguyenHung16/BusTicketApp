<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@android:color/white">

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Xin chào, Admin"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Menu quản lý"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnReports"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📊 Thống kê báo cáo"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnAdminBookings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🎫 Quản lý đặt vé"
                android:textSize="16sp"
                android:backgroundTint="#FF9800"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnTrips"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🚌 Quản lý Trips (Chuyến xe)"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnRoutes"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🛣️ Quản lý Routes (Tuyến)"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnOperators"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="🏢 Quản lý Operators (Nhà xe)"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnUsers"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="👥 Quản lý Users (Người dùng)"
                android:textSize="16sp"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Đăng xuất"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:backgroundTint="@android:color/holo_red_dark"
        android:layout_marginTop="16dp" />

</LinearLayout>
