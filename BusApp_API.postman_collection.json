        {
          "name": "1. Search Trips - Tìm kiếm chuyến xe",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response has content', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('content');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/trips/search?departure=Ho+Chi+Minh&destination=Ha+Noi&departureDate=2026-04-10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "trips", "search"],
              "query": [
                {
                  "key": "departure",
                  "value": "Ho Chi Minh"
                },
                {
                  "key": "destination",
                  "value": "Ha Noi"
                },
                {
                  "key": "departureDate",
                  "value": "2026-04-10"
                },
                {
                  "key": "page",
                  "value": "0",
                  "disabled": true
                },
                {
                  "key": "size",
                  "value": "10",
                  "disabled": true
                },
                {
                  "key": "sortBy",
                  "value": "price",
                  "disabled": true
                },
                {
                  "key": "sortDir",
                  "value": "asc",
                  "disabled": true
                }
              ]
            }
